#!/bin/bash
set -e
cd "$(dirname "$0")"
BOT_FILE="main.py"
LOG_FILE="bot.log"
PID_FILE="bot.pid"

if [ -f "$PID_FILE" ]; then 
    kill $(cat "$PID_FILE") 2>/dev/null || true
    rm -f "$PID_FILE"
fi

pkill -f ".*${BOT_FILE}" 2>/dev/null || true
pkill -f ".*chrome" 2>/dev/null || true
pkill -f ".*chromium" 2>/dev/null || true
sleep 2

# Archive previous log so tail -f only shows fresh output
if [ -f "$LOG_FILE" ]; then
    tail -n 300 "$LOG_FILE" > "${LOG_FILE}.old" 2>/dev/null || true
    > "$LOG_FILE"
fi

VENV_FOUND=0
for venv_path in ".venv" "$HOME/predction/predction/.venv" "$HOME/predction/.venv" "../predction/predction/.venv" "../.venv" "$HOME/.venv"; do
    if [ -f "$venv_path/bin/activate" ]; then
        . "$venv_path/bin/activate"
        VENV_FOUND=1
        break
    fi
done

if [ "$VENV_FOUND" -eq 0 ]; then
    echo "Creating virtual environment .venv..."
    python3 -m venv .venv 2>/dev/null || true
    if [ -f ".venv/bin/activate" ]; then
        . .venv/bin/activate
        pip install -r requirements.txt
    fi
fi

# Only try downloading playwright chromium if system Chrome is not already installed
if ! which google-chrome >/dev/null 2>&1 && ! which google-chrome-stable >/dev/null 2>&1 && ! which chromium-browser >/dev/null 2>&1 && ! which chromium >/dev/null 2>&1; then
    python3 -m playwright install chromium 2>/dev/null || true
fi

if [ ! -f ".env" ] && [ -f ".env.example" ]; then
    cp .env.example .env
fi

nohup python "$BOT_FILE" >> "$LOG_FILE" 2>&1 &
PID=$!
echo $PID > "$PID_FILE"
sleep 2

if ! kill -0 $PID 2>/dev/null; then
    echo "❌ Bot failed to start! Here is the error from $LOG_FILE:"
    echo "--------------------------------------------------------"
    cat "$LOG_FILE"
    echo "--------------------------------------------------------"
    exit 1
fi

echo "✅ WinGo VIP SureShot Hack Bot started successfully! PID: $PID"
