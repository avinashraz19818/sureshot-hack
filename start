#!/bin/bash
set -e
cd "$(dirname "$0")"
BOT_FILE="main.py"
LOG_FILE="bot.log"
PID_FILE="bot.pid"

if [ -f "$PID_FILE" ]; then 
    kill $(cat "$PID_FILE") 2>/dev/null || true
    rm -f "$PID_FILE"
fi

pkill -f ".*${BOT_FILE}" 2>/dev/null || true
pkill -f ".*chrome" 2>/dev/null || true
pkill -f ".*chromium" 2>/dev/null || true
sleep 2

# Archive previous log so tail -f only shows fresh output
if [ -f "$LOG_FILE" ]; then
    tail -n 300 "$LOG_FILE" > "${LOG_FILE}.old" 2>/dev/null || true
    > "$LOG_FILE"
fi

if [ -d ".venv" ]; then
    . .venv/bin/activate
elif [ -d "../.venv" ]; then
    . ../.venv/bin/activate
elif [ -d "$HOME/.venv" ]; then
    . "$HOME/.venv/bin/activate"
fi

# Only try downloading playwright chromium if system Chrome is not already installed
if ! which google-chrome >/dev/null 2>&1 && ! which google-chrome-stable >/dev/null 2>&1 && ! which chromium-browser >/dev/null 2>&1 && ! which chromium >/dev/null 2>&1; then
    python3 -m playwright install chromium 2>/dev/null || true
fi

if [ ! -f ".env" ] && [ -f ".env.example" ]; then
    cp .env.example .env
fi

nohup python3 "$BOT_FILE" >> "$LOG_FILE" 2>&1 &
echo $! > "$PID_FILE"
echo "✅ WinGo VIP SureShot Hack Bot started successfully! PID: $(cat "$PID_FILE")"
